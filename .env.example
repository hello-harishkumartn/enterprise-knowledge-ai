# Copy to .env and fill in as needed. docker-compose.yml reads this file
# automatically; local (non-Docker) backend runs read backend/.env instead
# (pydantic-settings loads whichever .env sits next to where you run it —
# see docs/DEPLOYMENT.md for both setups).

# --- Environment ---------------------------------------------------------
ENV=development

# --- Database (Docker default shown; override for hosted/Supabase Postgres) ---
DATABASE_URL=postgresql+psycopg://ekai:ekai@localhost:5432/ekai

# --- Auth ------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me

# --- LLM providers, tried in this order until one succeeds ----------------
# "mock" is always a safe last resort with zero external dependencies.
LLM_PROVIDER_ORDER=gemini,ollama,mock

# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local Ollama daemon (ollama.com) — only used if Gemini is unavailable.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Hosted deployment only (Supabase) — see docs/DEPLOYMENT.md ------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
